DirectoryIndex landing.php

# Block dotfiles. This said "and other dotfiles" but only ever named .env,
# leaving .DS_Store (which lists directory contents), .user.ini and .mise.toml
# downloadable. Matches filenames only, so .well-known/ contents still resolve.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Baseline response headers.
#
# No Content-Security-Policy here on purpose: every page inlines a <script> for
# its window.*_CONFIG globals and inline style attributes throughout, and pulls
# Leaflet, noUiSlider and Font Awesome from three separate CDNs. A policy loose
# enough to allow all of that ('unsafe-inline' plus four hosts) would buy very
# little, and a tight one would take nonces on every inline block. Worth doing
# as its own change, not as a side effect of one.
<IfModule mod_headers.c>
    # public/images/ is user-uploaded and served directly, so a file that
    # sniffs as HTML must not be treated as HTML.
    Header always set X-Content-Type-Options "nosniff"

    # Listing pages carry addresses and contact details; don't leak the full
    # path of one in the Referer when a user follows an outbound link.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Authentication is ambient (CAS via browser credentials), so framing this
    # site elsewhere is a clickjacking path against signed-in users.
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Pretty share links: /s/42-a1b2c3d4e5 -> /s.php?i=42-a1b2c3d4e5
#
# Short enough to sit under an Instagram story sticker without wrapping, which
# /s.php?i=... is not. s.php still answers on its own path, so if this rule ever
# stops matching the feature degrades to an uglier URL rather than a 404.
#
# The pattern is as narrow as the slug itself, so this cannot shadow any real
# file. mod_rewrite does not inherit per-directory rules, so app/.htaccess —
# which has its own RewriteEngine — is unaffected by turning it on here.
RewriteEngine On
RewriteRule ^s/([0-9]+-[a-f0-9]{10})/?$ /s.php?i=$1 [L,QSA]
