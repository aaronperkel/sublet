DirectoryIndex landing.php

# Block dotfiles. This said "and other dotfiles" but only ever named .env,
# leaving .DS_Store (which lists directory contents), .user.ini and .mise.toml
# downloadable. Matches filenames only, so .well-known/ contents still resolve.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Refuse everything in the tree that is not meant to be fetched. The docroot is
# also the git checkout, so it holds files that only make sense on disk:
#
#   - any path segment starting with a dot (.git/, .claude/, a stray .env),
#     except .well-known/ — the FilesMatch above only sees file names, so it
#     could not catch a dot-directory's contents
#   - includes/ and vendor/, which PHP requires from disk; requested directly
#     they would execute out of context
#   - data/, read from disk by header.php and app/api/announcement.php
#   - docs and Composer metadata (*.md, composer.json/lock)
#
# RedirectMatch rather than <If>/Require: Require is replaced, not merged, by a
# subdirectory's own (app/.htaccess has one), whereas mod_alias rules from here
# still apply under app/ and recover/. Nothing on the site links to any of
# these paths, so a 403 is only ever seen by someone probing for them.
RedirectMatch 403 "(^|/)\.(?!well-known(/|$))"
RedirectMatch 403 "^/(includes|vendor|data)(/|$)"
RedirectMatch 403 "(?i)\.md$"
RedirectMatch 403 "(^|/)composer\.(json|lock|phar)$"

# Baseline response headers.
#
# No Content-Security-Policy here on purpose: every page inlines a <script> for
# its window.*_CONFIG globals and inline style attributes throughout, and pulls
# Leaflet, noUiSlider and Font Awesome from three separate CDNs. A policy loose
# enough to allow all of that ('unsafe-inline' plus four hosts) would buy very
# little, and a tight one would take nonces on every inline block. Worth doing
# as its own change, not as a side effect of one.
<IfModule mod_headers.c>
    # public/images/ is user-uploaded and served directly, so a file that
    # sniffs as HTML must not be treated as HTML.
    Header always set X-Content-Type-Options "nosniff"

    # Listing pages carry addresses and contact details; don't leak the full
    # path of one in the Referer when a user follows an outbound link.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Authentication is ambient (CAS via browser credentials), so framing this
    # site elsewhere is a clickjacking path against signed-in users.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Cache scripts, stylesheets and fonts for a year without revalidating.
    # Safe only because every reference carries ?v=<filemtime>, so an edit is a
    # new URL: a <link> or <script> added without one would be stuck on the
    # first version anyone fetched. Fonts are referenced from CSS url(), which
    # has no ?v — give a changed font file a new name instead of overwriting it.
    # Images get the same treatment in public/.htaccess.
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Compress text responses. style.css and app.js were going out uncompressed at
# 55 KB and 93 KB. AddOutputFilterByType belongs to mod_filter in Apache 2.4,
# hence the second guard: without it, a missing module would be a 500.
<IfModule mod_filter.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

# Pretty share links: /s/42-a1b2c3d4e5 -> /s.php?i=42-a1b2c3d4e5
#
# Short enough to sit under an Instagram story sticker without wrapping, which
# /s.php?i=... is not. s.php still answers on its own path, so if this rule ever
# stops matching the feature degrades to an uglier URL rather than a 404.
#
# The pattern is as narrow as the slug itself, so this cannot shadow any real
# file. mod_rewrite does not inherit per-directory rules, so app/.htaccess —
# which has its own RewriteEngine — is unaffected by turning it on here.
RewriteEngine On
RewriteRule ^s/([0-9]+-[a-f0-9]{10})/?$ /s.php?i=$1 [L,QSA]

# The read-only demo at /demo/ was retired. Old links (the README, past story
# posts) land on the front page instead of a 404. Deliberately a 302: a 301 is
# cached by browsers indefinitely, and a new demo may take this path back.
RewriteRule ^demo(/.*)?$ / [R=302,L]
