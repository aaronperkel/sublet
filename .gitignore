# Composer
composer.phar
vendor/

# Generated share cards. Derived from the photos below, so the same reasoning
# applies — and they are a cache: share-card.php rebuilds any of them on the
# next request.
public/share/

# User-uploaded listing photos. These are real students' images, and this
# repository is public — they must never be committed. Project-owned imagery (favicon, social graphics) lives in assets/
# instead, which is tracked. public/.htaccess is still tracked.
public/images/

